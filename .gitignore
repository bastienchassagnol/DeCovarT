*.gls
*.ist
*.xdy
*.spl
*.dvi
*.ps
*-blx.bib
_minted*/

# specific R files
.Rhistory
inst/doc
simulation_*
older_functions/
tests/testthat/simulations/
.Renviron
.Renviron.local

# my folders
# Retired notes and figures. Ignore the whole directory.
/archives/
# Track Quarto slide sources; ignore bulky legacy decks and render output
slides/**/*.pdf
slides/**/*.pptx
slides/**/*.docx
slides/**/*.html
slides/.quarto/
data/raw-data/
docs
**/.quarto/

# Bib enrichment tooling / backups
scripts/curate_bibliography/.venv/
scripts/benchmark_metrics/python/.venv/
*.bib.bak
scripts/curate_bibliography/bib-enrichment.json
# Ad-hoc Zotero collection exports (merge into inst/REFERENCES.bib)
IV) build signature matrix.bib

# LibreOffice lock files
**/.~lock.*

# zotcurate local credentials (never commit)
.zotc/
.venv-zotcurate/
output/zotero/
output/archives/
__pycache__/
.ruff_cache/

# Graphify knowledge graph (local only; rebuilt by hook or graphify update)
graphify-out/

# Background logs from scripts/fig0*.R (nohup). Ignore the whole directory.
/logs/

# Local notes and failing-matrix dumps. Ignore the whole directory.
/scripts/failed_reports/

# Generated manuals and article PDF (CI / local latexmk)
article/*.pdf
output/manual/

# scripts/generate_random_markov_network.R: exploratory outputs (gene
# summary CSV, heatmap, interactive visNetwork widgets + dependency
# folders). The single static counterpart embedded by the pkgdown
# vignette lives at vignettes/figures/fig_network_topologies.png (tracked).
output/random_markov_network/
/doc/
/Meta/

# Local RAG extracts and scratch drafts (kept on disk, not in the package)
/temp_*/
/temp_prompt*

# Machine-specific Quarto environment (TIKZ_BIN for scripts/tikz-lualatex.sh)
vignettes/_environment.local

# Local reference PDF (about 3 MB). Kept out of Git; the pre-commit
# large-file hook rejects anything over 2000 KB.
vignettes/burakov-logistic-regression.pdf

# Document extractions (document-extraction rule)
.firecrawl/

# Local literature PDFs used for reviews (copyrighted; not redistributed).
# The comparison note and its PDF stay tracked. Only source copies under
# resources/ stay out of Git (several exceed the 2000 KB hook).
answer-cardamomOT/resources/
answer-cardamomOT/report/*.pdf
answer-cardamomOT/report/*.aux
answer-cardamomOT/report/*.bbl
answer-cardamomOT/report/*.bcf
answer-cardamomOT/report/*.blg
answer-cardamomOT/report/*.fdb_latexmk
answer-cardamomOT/report/*.fls
answer-cardamomOT/report/*.log
answer-cardamomOT/report/*.out
answer-cardamomOT/report/*.run.xml
answer-cardamomOT/report/_minted*/

*.Rproj
*.Rproj.user
.Rproj.user
*.zip
*.gz
/build/
simulations/*
# Script simulation outputs: track PDF / PNG figures; ignore RDS and other
# bulky artefacts. Directories must be un-ignored first or Git will not
# see the files inside `output/`.
output/**
!output/**/
!output/**/*.pdf
!output/**/*.png
# Generated RDS artefacts from simulation scripts
data/synthetic_networks/*.rds


@incollection{CoordinateRepresentation2015,
  title = {Coordinate Representation},
  booktitle = {Modelling and {{Analysis}} of {{Compositional Data}}},
  year = 2015,
  pages = {32--64},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9781119003144.ch4},
  urldate = {2026-10-19},
  abstract = {To introduce transformations based on ratios, Aitchison (1986) used the fact that, for compositional data, size is irrelevant as interest lies in relative proportions of the components measured. This chapter presents isometric logratio (ilr) for the association of coordinates with compositions in an orthonormal system in general. A first step for defining an appropriate orthonormal basis consists of finding a generating system that can be used to build the basis. The basis thus obtained will be just one out of the infinitely many orthonormal basis that can be defined in any Euclidean space. The main criterion for the selection of the orthonormal basis is that it should enhance interpretability of the representation in coordinates. The coordinates correspond to the well-known additive logratio transformation (alr) introduced by Aitchison. Orthogonal projections are of uppermost importance in geometry and statistics as they are the base of dimension reduction.},
  chapter = {4},
  copyright = {Copyright \copyright{} 2015 John Wiley \& Sons, Ltd},
  isbn = {978-1-119-00314-4},
  langid = {english},
  keywords = {additive logratio transformation (alr),coordinate representation,Euclidean structures,isometric logratio (ilr) transformations,orthogonal projections,orthonormal coordinates}
}
